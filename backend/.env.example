# Copy this file to .env for local development (never commit the real .env).
# In production (Render, etc.) set these as dashboard environment variables instead.

ODOO_URL=https://yourcompany.odoo.com
ODOO_DB=yourcompany
ODOO_USERNAME=api-user@yourcompany.com
ODOO_API_KEY=your-odoo-api-key

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=https://corebase.az,http://localhost:8000

PORT=5000

# --- Analytics / admin panel ---
# Postgres connection string (e.g. from a free Neon or Supabase project).
DATABASE_URL=postgresql://user:password@host/dbname

# Password for the /admin dashboard.
ADMIN_PASSWORD=change-me

# Random secret used to sign admin session cookies. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
