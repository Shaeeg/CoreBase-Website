# Copy this file to .env for local development (never commit the real .env).
# In production (Render, etc.) set these as dashboard environment variables instead.

ODOO_URL=https://yourcompany.odoo.com
ODOO_DB=yourcompany
ODOO_USERNAME=api-user@yourcompany.com
ODOO_API_KEY=your-odoo-api-key

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=https://corebase.az,http://localhost:8000

PORT=5000
